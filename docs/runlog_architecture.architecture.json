      "via": [
        [
          1255,
          420
        ],
        [
          680,
          420
        ]
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Every run, automatically",
      "items": [
        "PiLink.__init__ spawns the recorder and the Pi agent, close() stops both",
        "Run id is the timestamp: YYYYmmdd_HHMMSS_mmm",
        "Covers all 8 PiLink scripts; RUNLOG=0 disables"
      ]
    },
    {
      "dot": "emerald",
      "title": "Timestamps",
      "items": [
        "log_time = recorder receipt, host clock",
        "publish_time = source time: Pi stamp + offset, camera stamp",
        "/clock/pi at 1 Hz: t_recv, t_pi, offset, for offline re-fit"
      ]
    },
    {
      "dot": "rose",
      "title": "Never blocks the loop",
      "items": [
        "Datagrams drop under backpressure instead of waiting",
        "Images never cross the socket; the recorder tails /dev/shm",
        "A recorder crash does not stop the run"
      ]
    },
    {
      "dot": "amber",
      "title": "Everything from the Pi and the drives",
      "items": [
        "HAL pins via halsampler at the servo rate, no polling",
        "LinuxCNC error channel: faults and Power OFF",
        "candump of every CAN frame: the drives' status words",
        "robot_hal stdout, pro600 debug, dmesg, start/stop snapshots",
        "runlog check fails the run if any source is missing"
      ]
    }
  ]
}